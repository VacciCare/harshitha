<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <Button
            android:id="@+id/btnBackAppointmentDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Back"
            android:layout_marginBottom="15dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Appointment Details"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="25dp" />

        <TextView
            android:id="@+id/txtDetailAppointmentId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Appointment ID:"
            android:textSize="17sp"
            android:layout_marginBottom="15dp" />

        <TextView
            android:id="@+id/txtDetailChild"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Child:"
            android:textSize="17sp"
            android:layout_marginBottom="15dp" />

        <TextView
            android:id="@+id/txtDetailVaccine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Vaccine / Service:"
            android:textSize="17sp"
            android:layout_marginBottom="15dp" />

        <TextView
            android:id="@+id/txtDetailHospital"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hospital:"
            android:textSize="17sp"
            android:layout_marginBottom="15dp" />

        <TextView
            android:id="@+id/txtDetailDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Date:"
            android:textSize="17sp"
            android:layout_marginBottom="15dp" />

        <TextView
            android:id="@+id/txtDetailTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Time:"
            android:textSize="17sp"
            android:layout_marginBottom="15dp" />

        <TextView
            android:id="@+id/txtDetailStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Status:"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginBottom="25dp" />

        <Button
            android:id="@+id/btnEditAppointment"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Edit / Modify Appointment"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnCancelAppointment"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Cancel Appointment" />

    </LinearLayout>

</ScrollView>